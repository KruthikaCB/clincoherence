# ========================
# ClinCoherence .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# --- Node.js ---
node_modules/
.pnp/
.pnp.js

# --- Next.js ---
.next/
out/

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
test-results/
playwright-report/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Environment ---
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.local.example

# Private keys and certificates
*.pem
*.key

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database ---
*.sqlite
*.sqlite3
*.db
*.sql

# --- Misc ---
*.bak
*.tmp
*.temp

# Local datasets - do not commit
/clincoherence/capstone datasets/

