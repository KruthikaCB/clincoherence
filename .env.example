# ========================
# ClinCoherence Environment Variables
# ========================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clincoherence_user:changeme@localhost:5432/clincoherence_db

# --- Authentication ---
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Prototype-only synthetic patient onboarding ---
# Link targets the frontend activation flow; the token is placed in its fragment.
INVITATION_URL_ORIGIN=http://localhost:3000
INVITATION_EXPIRE_MINUTES=1440

# --- Application ---
PROJECT_NAME=ClinCoherence
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- LLM Provider ---
# Options: mock, openai, local
LLM_PROVIDER=mock
# LLM_API_KEY=your-api-key-here
# LLM_MODEL_NAME=gpt-4
# LLM_BASE_URL=http://localhost:11434

